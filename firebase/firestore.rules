rules_version = '2';

// Luật bảo mật Firestore cho "Trợ Lý Giáo Viên Hoá Học".
// Dán vào Firebase Console > Firestore Database > Rules, rồi bấm Publish.
//
// Nguyên tắc:
// - Nội dung riêng của giáo viên (bài giảng, ngân hàng câu hỏi, chỉnh sửa chương) CHỈ chính giáo viên đó
//   (đã đăng nhập Google, đúng uid) mới đọc/ghi được — đây là dữ liệu có giá trị nhất, bảo vệ chặt nhất.
// - Nhóm/đề kiểm tra: ai cũng đọc được (để học sinh vào nhóm bằng mã, không cần tài khoản), nhưng CHỈ
//   giáo viên sở hữu (đúng teacherUid) mới tạo/sửa/xoá được.
// - Đề kiểm tra tách làm 2 phần: "exams" (câu hỏi, không có đáp án — công khai) và "examAnswers"
//   (đáp án đúng — chỉ tải về lúc học sinh bấm nộp bài). Vì không dùng Cloud Functions nên đây là giới
//   hạn đã biết: học sinh rành kỹ thuật vẫn có thể đọc được examAnswers nếu cố tình — chấp nhận đánh đổi
//   để không cần gói trả phí (Blaze) của Firebase.
// - Học sinh cũng đăng nhập Google (dùng CHUNG hệ Auth với giáo viên, không có hồ sơ giáo viên nào
//   được tạo thêm — xem js/features/auth.js: requireStudentAuth) để nhóm/tiến độ học/gói đã mua gắn
//   với tài khoản, không mất khi đổi thiết bị. Được TẠO (create) bản ghi tham gia nhóm / nộp bài
//   ĐÚNG uid của mình, nhưng không sửa/xoá được bản ghi của người khác.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Kinh doanh: gói trả phí + hoa hồng giới thiệu (xem js/features/monetization.js) ----------
    // Admin DUY NHẤT xác định bằng email tài khoản Google — hardcode vì app chỉ có 1 người quản trị,
    // không cần vai trò/danh sách quyền phức tạp hơn.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'chinhhuynh89@gmail.com';
    }

    // Cấu hình chung: bật/tắt chiến dịch kinh doanh, giá gói, % hoa hồng, thông tin chuyển khoản —
    // ai cũng đọc được (mọi trang cần biết để hiện đúng giá/giới hạn), chỉ admin sửa được.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Trạng thái gói trả phí — TÁCH RIÊNG khỏi "teachers"/"studentSubscriptions" khỏi bản ghi khác vì
    // rule "teachers" bên dưới cho phép chính giáo viên ghi toàn bộ doc của họ: nếu lưu chung, giáo
    // viên có thể tự sửa field để tự cấp gói Pro. Ở đây CHỈ ADMIN ghi được, sau khi duyệt thanh toán
    // thủ công (paymentSubmissions bên dưới) — không ai tự nâng gói được.
    match /subscriptions/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Khoá theo studentUid (uid tài khoản Google của học sinh — xem js/features/auth.js:
    // requireStudentAuth), KHÔNG còn theo "deviceId" ngẫu nhiên như trước (đổi thiết bị là mất gói).
    match /studentSubscriptions/{studentUid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Yêu cầu "Tôi đã chuyển khoản" — tạo được nếu đúng uid của người gửi (giáo viên: submitterUid;
    // học sinh: submitterStudentUid), admin vẫn tự đối chiếu số tiền/nội dung chuyển khoản thực tế
    // trước khi duyệt (không tự động hoá được vì không dùng Cloud Functions). Chỉ admin đọc được
    // TOÀN BỘ danh sách (để duyệt) và sửa trạng thái; người gửi đọc được đúng yêu cầu của mình để
    // biết đã duyệt hay chưa.
    match /paymentSubmissions/{id} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.submitterUid == request.auth.uid)
                  || (request.auth != null && resource.data.submitterStudentUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll(['type', 'submitterName', 'amount', 'status', 'createdAt', 'orderCode'])
                    && request.resource.data.status == 'pending'
                    && (request.resource.data.type != 'teacher_upgrade'
                        || (request.auth != null && request.auth.uid == request.resource.data.submitterUid))
                    && (request.resource.data.type != 'student_upgrade'
                        || (request.auth != null && request.auth.uid == request.resource.data.submitterStudentUid));
      allow update, delete: if isAdmin();
    }

    // Hoa hồng phát sinh khi admin duyệt 1 yêu cầu có người giới thiệu — chỉ admin tạo/sửa (tự sinh
    // lúc duyệt thanh toán); giáo viên hưởng hoa hồng đọc được đúng phần của mình.
    match /commissions/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.beneficiaryTeacherUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Lịch sử đổi % hoa hồng F1/F2 + số ngày giữ hoa hồng — chỉ admin xem/sửa, dùng để đối chiếu
    // (không dùng để TÍNH LẠI hoa hồng cũ — mỗi "commissions" đã tự lưu % dùng lúc phát sinh).
    match /commissionRateHistory/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- 1 tài khoản Google CHỈ 1 vai trò (giáo viên HOẶC học sinh), không lẫn lộn ----------
    // Xem js/features/auth.js: enforceExclusiveRole(). Ghi ĐÚNG 1 LẦN lúc tài khoản lần đầu xác định
    // được vai trò (create) — người dùng thường KHÔNG tự sửa/xoá được (update luôn false, tránh mọi
    // đường lách tự đổi vai trò qua lại). CHỈ admin xoá được (delete) — dùng cho công cụ "Đặt lại tài
    // khoản" ở trang quản trị (js/features/admin.js: buildResetAccountSection) để tự test lại hoặc
    // sửa cho người dùng chọn nhầm vai trò; xoá xong, lần đăng nhập tiếp theo sẽ được chọn lại vai
    // trò từ đầu. "code" là mã cố định GV.../HS... (deriveTeacherCode/deriveStudentCode), sinh cùng
    // lúc khoá vai trò. Không có gì nhạy cảm nên cho đọc công khai.
    match /accountRoles/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['role', 'code', 'createdAt'])
                    && request.resource.data.role in ['teacher', 'student'];
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Dữ liệu riêng của giáo viên ----------
    // Hồ sơ giáo viên: chỉ chính họ đọc/ghi (chứa cả email — KHÔNG công khai). Phần cần hiện cho
    // học sinh (tên hiển thị, khẩu hiệu, ảnh đại diện) tách riêng ở collection teacherProfiles bên
    // dưới để không lộ email khi công khai.
    match /teachers/{teacherId} {
      // Admin đọc thêm được — cần tra "referredBy" (mã giới thiệu) của giáo viên F1 để tính ra F2 lúc
      // duyệt hoa hồng (xem js/features/admin.js approvePayment). Admin GHI thêm được (chỉ để XOÁ,
      // dùng cho công cụ "Đặt lại tài khoản" — xem chú thích accountRoles ở trên) — không có UI nào
      // khác cho admin sửa nội dung hồ sơ giáo viên người khác.
      allow read: if request.auth != null && (request.auth.uid == teacherId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == teacherId || isAdmin());

      // Nội dung biên soạn (bài giảng, câu hỏi, sửa chương): AI CŨNG ĐỌC ĐƯỢC (để học sinh trong nhóm
      // của giáo viên đó thấy nội dung khi học), CHỈ chính giáo viên hoặc admin (công cụ đặt lại tài
      // khoản) mới sửa/xoá được.
      match /customLessons/{lessonId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == teacherId || isAdmin());
      }
      match /customQuiz/{quizId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == teacherId || isAdmin());
      }
      match /customFlashcards/{cardId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == teacherId || isAdmin());
      }
      match /chapterMeta/{chapterId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == teacherId || isAdmin());
      }
    }

    // ---------- Nhóm học sinh ----------
    match /groups/{groupId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // ---------- Học sinh tham gia nhóm ----------
    // Bản ghi "students" LUÔN do GIÁO VIÊN tạo (giáo viên tick chọn học sinh có sẵn, hoặc duyệt 1
    // đăng ký đang chờ — xem js/features/groups-data.js: addStudentToGroup/assignRegistrationToGroup)
    // — học sinh KHÔNG tự tạo thẳng bản ghi này (phải qua "studentRegistrations" chờ duyệt trước).
    // studentUid: uid tài khoản Google của học sinh (xem js/features/auth.js: requireStudentAuth) —
    // dùng để gộp 1 học sinh qua nhiều nhóm và để gói/tiến độ học không mất khi đổi thiết bị.
    // teacherUid: gắn từ bản ghi tạo, dùng để xác định đúng giáo viên sở hữu được xoá. Bản ghi CŨ
    // (tạo trước khi có teacherUid) — cho phép "nhận sở hữu" 1 lần (chỉ set được khi CHƯA có, và chỉ
    // đổi đúng field này) để giáo viên xoá được cả học sinh cũ; xem getStudentsForGroup() tự làm
    // việc này khi giáo viên xem đúng nhóm của mình.
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherUid
                    && request.resource.data.keys().hasAll(
                      ['groupCode', 'teacherUid', 'studentUid', 'studentName', 'school', 'className', 'address', 'phone', 'joinedAt']
                    );
      allow update: if request.auth != null
                    && !('teacherUid' in resource.data)
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherUid']);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.teacherUid || isAdmin());
    }

    // ---------- Đề kiểm tra (câu hỏi, không có đáp án) ----------
    match /exams/{examId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // ---------- Đáp án đúng (tách riêng khỏi exams) ----------
    match /examAnswers/{examId} {
      allow read: if true; // học sinh cần đọc lúc tự chấm điểm khi nộp bài
      allow create: if request.auth != null;
      allow update: if false; // luôn bất biến — kể cả admin
      allow delete: if isAdmin(); // chỉ để dọn dẹp qua công cụ "Đặt lại tài khoản"
    }

    // ---------- Bài nộp của học sinh ----------
    // studentUid PHẢI khớp request.auth.uid (xem js/features/auth.js: requireStudentAuth) — trước
    // đây chỉ khoá theo "deviceId" tự khai, ai cũng ghi được bản ghi mạo danh học sinh khác; giờ bắt
    // buộc đăng nhập Google nên siết lại được, khó giả mạo/nộp hộ hơn hẳn.
    match /submissions/{submissionId} {
      allow read: if true; // giáo viên xem thống kê
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentUid
                    && request.resource.data.keys().hasAll(['examId', 'studentId', 'answers', 'score', 'studentUid']);
      allow update: if false;
      allow delete: if isAdmin(); // chỉ để dọn dẹp qua công cụ "Đặt lại tài khoản"
    }

    // ---------- Học sinh bắt đầu làm bài (để giáo viên theo dõi real-time ai đang làm bài) ----------
    match /examStarts/{startId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentUid
                    && request.resource.data.keys().hasAll(['examId', 'studentId', 'studentName', 'studentUid', 'startedAt']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Tiến độ học theo chương của từng học sinh (để giáo viên xem "Kết quả học tập") ----------
    // 1 doc/học sinh (id = studentId), tự cập nhật liên tục khi học sinh học.
    match /progress/{studentId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.studentUid
                    && request.resource.data.keys().hasAll(['studentId', 'groupCode', 'studentUid']);
      allow delete: if isAdmin(); // chỉ để dọn dẹp qua công cụ "Đặt lại tài khoản"
    }

    // ---------- Chương trình đào tạo riêng do giáo viên tự tạo (ngoài lớp 6-12 mặc định) ----------
    match /programs/{programId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }
    match /programChapters/{chapterId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // ---------- Học sinh xin vào nhóm, chờ giáo viên duyệt ----------
    // Dùng cho 2 luồng: (1) đăng ký bằng MÃ GIÁO VIÊN — chưa biết nhóm cụ thể, giáo viên tự xếp sau
    // (có teacherCode, không có groupCode); (2) xin vào 1 nhóm cụ thể bằng MÃ NHÓM — đã biết nhóm,
    // giáo viên chỉ cần duyệt/từ chối (có groupCode, không có teacherCode). Khác với "students" (vào
    // thẳng không cần duyệt): đây LUÔN cần giáo viên xác nhận trước khi có bản ghi "students" thật.
    // Có SĐT/địa chỉ nên CHỈ giáo viên sở hữu đọc được (khác với "students" vốn cho đọc công khai).
    // studentUid PHẢI khớp request.auth.uid — học sinh phải đăng nhập Google mới đăng ký được.
    match /studentRegistrations/{regId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.teacherUid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentUid
                    && request.resource.data.keys().hasAll(
                      ['teacherUid', 'studentName', 'school', 'className', 'address', 'phone', 'studentUid', 'status', 'createdAt']
                    );
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.teacherUid || isAdmin());
    }

    // ---------- Phần hồ sơ giáo viên hiện công khai (thương hiệu trang chủ cho học sinh xem) ----------
    // Tách khỏi "teachers" ở trên vì doc đó có email — không được công khai. Doc này CHỈ chứa tên
    // hiển thị/khẩu hiệu/ảnh đại diện, không có gì nhạy cảm.
    match /teacherProfiles/{teacherUid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == teacherUid || isAdmin());
    }
  }
}
